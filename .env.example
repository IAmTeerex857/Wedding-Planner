VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Trigger.dev worker environment only. Never prefix these with VITE_.
OPENAI_API_KEY=server-only-openai-key
APIFY_TOKEN=server-only-apify-token
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key

# Azure OpenAI can be used instead of OPENAI_API_KEY.
AZURE_OPENAI_API_KEY=server-only-azure-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-5.6-luna
# SUPABASE_SECRET_KEY can be used instead of SUPABASE_SERVICE_ROLE_KEY.

# Supabase Edge Function secret used to enqueue Trigger.dev runs.
TRIGGER_SECRET_KEY=server-only-trigger-key
APP_URL=https://your-app.example.com

# All server-only values belong in their deployment provider's secret store.
# Never expose them through a VITE_ environment variable.
